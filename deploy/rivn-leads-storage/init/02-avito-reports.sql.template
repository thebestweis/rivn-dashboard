\set ON_ERROR_STOP on

create table if not exists public.avito_report_clients (
  id uuid primary key default gen_random_uuid(),
  workspace_id uuid not null,
  project_id uuid,
  name text not null,
  client_code text unique,
  telegram_chat_id text,
  is_active boolean not null default true,
  daily_reports_enabled boolean not null default true,
  weekly_reports_enabled boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.avito_report_accounts (
  id uuid primary key default gen_random_uuid(),
  client_id uuid not null
    references public.avito_report_clients(id) on delete cascade,
  name text not null,
  access_token text,
  avito_user_id text,
  avito_client_id text,
  avito_client_secret text,
  crm_dialogs_enabled boolean not null default true,
  is_active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.avito_report_chat_links (
  id uuid primary key default gen_random_uuid(),
  client_id uuid not null
    references public.avito_report_clients(id) on delete cascade,
  telegram_chat_id text not null unique,
  telegram_chat_title text,
  linked_by_telegram_id text,
  linked_by_username text,
  is_active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.avito_report_logs (
  id uuid primary key default gen_random_uuid(),
  client_id uuid not null
    references public.avito_report_clients(id) on delete cascade,
  telegram_chat_id text,
  report_type text not null,
  period_start date,
  period_end date,
  status text not null,
  message text,
  error text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.avito_report_metrics (
  id uuid primary key default gen_random_uuid(),
  client_id uuid not null
    references public.avito_report_clients(id) on delete cascade,
  account_id uuid
    references public.avito_report_accounts(id) on delete cascade,
  report_type text not null,
  period_start date not null,
  period_end date not null,
  views integer not null default 0,
  contacts integer not null default 0,
  favorites integer not null default 0,
  expenses numeric not null default 0,
  conversion numeric not null default 0,
  cost_per_contact numeric not null default 0,
  raw jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique nulls not distinct (
    client_id,
    account_id,
    report_type,
    period_start,
    period_end
  )
);

create table if not exists public.avito_report_expenses (
  id uuid primary key default gen_random_uuid(),
  account_id uuid not null
    references public.avito_report_accounts(id) on delete cascade,
  expense_date date not null,
  amount numeric not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (account_id, expense_date)
);

create table if not exists public.avito_report_item_cache (
  id uuid primary key default gen_random_uuid(),
  account_id uuid not null
    references public.avito_report_accounts(id) on delete cascade,
  avito_user_id text,
  item_ids jsonb not null default '[]'::jsonb,
  next_page integer not null default 1,
  is_complete boolean not null default true,
  fetched_at timestamptz not null default now(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (account_id)
);

create table if not exists public.avito_report_stats_cache (
  id uuid primary key default gen_random_uuid(),
  account_id uuid not null
    references public.avito_report_accounts(id) on delete cascade,
  avito_user_id text not null,
  date_from date not null,
  date_to date not null,
  item_ids_hash text not null,
  views integer not null default 0,
  contacts integer not null default 0,
  favorites integer not null default 0,
  processed_chunks integer not null default 0,
  total_chunks integer not null default 0,
  is_complete boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (account_id, date_from, date_to)
);

create table if not exists public.avito_report_snapshots (
  id uuid primary key default gen_random_uuid(),
  client_id uuid
    references public.avito_report_clients(id) on delete cascade,
  account_id uuid
    references public.avito_report_accounts(id) on delete cascade,
  report_type text not null default 'daily',
  period_type text not null default 'daily',
  period_start date,
  period_end date,
  views integer not null default 0,
  contacts integer not null default 0,
  favorites integer not null default 0,
  expenses numeric not null default 0,
  conversion numeric not null default 0,
  cost_per_contact numeric not null default 0,
  stats_status text not null default 'pending',
  expenses_status text not null default 'pending',
  quality_status text not null default 'pending',
  warnings text[] not null default '{}',
  attempts integer not null default 0,
  last_error text,
  raw jsonb not null default '{}'::jsonb,
  fetched_at timestamptz,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (account_id, report_type, period_start, period_end)
);

create table if not exists public.avito_report_sync_jobs (
  id uuid primary key default gen_random_uuid(),
  client_id uuid
    references public.avito_report_clients(id) on delete cascade,
  account_id uuid
    references public.avito_report_accounts(id) on delete cascade,
  report_type text not null default 'daily',
  period_start date,
  period_end date,
  status text not null default 'pending',
  priority integer not null default 100,
  attempts integer not null default 0,
  next_run_at timestamptz not null default now(),
  locked_at timestamptz,
  last_error text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (account_id, report_type, period_start, period_end)
);

create table if not exists public.avito_telegram_delivery_queue (
  id uuid primary key default gen_random_uuid(),
  client_id uuid not null
    references public.avito_report_clients(id) on delete cascade,
  telegram_chat_id text not null,
  report_type text not null,
  period_start date not null,
  period_end date not null,
  dedupe_key text,
  message text not null,
  status text not null default 'pending'
    check (status in ('pending', 'processing', 'sent', 'failed')),
  attempts integer not null default 0,
  last_error text,
  telegram_message_id text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  sent_at timestamptz
);

alter table public.avito_telegram_delivery_queue
  add column if not exists dedupe_key text;

with ranked_deliveries as (
  select
    id,
    client_id,
    report_type,
    period_start,
    period_end,
    row_number() over (
      partition by client_id, report_type, period_start, period_end
      order by
        case status
          when 'sent' then 1
          when 'processing' then 2
          when 'pending' then 3
          else 4
        end,
        created_at,
        id
    ) as delivery_rank
  from public.avito_telegram_delivery_queue
  where report_type in ('daily', 'weekly')
    and dedupe_key is null
)
update public.avito_telegram_delivery_queue as queue
set dedupe_key = concat_ws(
  ':',
  queue.client_id::text,
  queue.report_type,
  queue.period_start::text,
  queue.period_end::text
)
from ranked_deliveries as ranked
where queue.id = ranked.id
  and ranked.delivery_rank = 1
  and not exists (
    select 1
    from public.avito_telegram_delivery_queue as existing
    where existing.client_id = ranked.client_id
      and existing.report_type = ranked.report_type
      and existing.period_start = ranked.period_start
      and existing.period_end = ranked.period_end
      and existing.dedupe_key is not null
  );

create index if not exists avito_report_clients_workspace_idx
  on public.avito_report_clients(workspace_id, is_active);
create index if not exists avito_report_accounts_client_idx
  on public.avito_report_accounts(client_id, is_active);
create index if not exists avito_report_accounts_user_idx
  on public.avito_report_accounts(avito_user_id);
create index if not exists avito_report_logs_client_period_idx
  on public.avito_report_logs(client_id, report_type, period_start, period_end);
create index if not exists avito_report_logs_created_idx
  on public.avito_report_logs(created_at desc);
create index if not exists avito_report_metrics_client_period_idx
  on public.avito_report_metrics(client_id, report_type, period_start, period_end);
create index if not exists avito_report_expenses_account_date_idx
  on public.avito_report_expenses(account_id, expense_date);
create index if not exists avito_report_item_cache_fetched_idx
  on public.avito_report_item_cache(fetched_at desc);
create index if not exists avito_report_stats_cache_period_idx
  on public.avito_report_stats_cache(date_from, date_to);
create index if not exists avito_report_snapshots_client_period_idx
  on public.avito_report_snapshots(client_id, report_type, period_start, period_end);
create index if not exists avito_report_snapshots_quality_idx
  on public.avito_report_snapshots(quality_status, stats_status, expenses_status);
create index if not exists avito_report_sync_jobs_due_idx
  on public.avito_report_sync_jobs(status, next_run_at, priority);
create index if not exists avito_telegram_queue_status_created_idx
  on public.avito_telegram_delivery_queue(status, created_at);
create unique index if not exists avito_telegram_queue_dedupe_idx
  on public.avito_telegram_delivery_queue(dedupe_key)
  where dedupe_key is not null;

grant select, insert, update, delete
  on public.avito_report_clients,
     public.avito_report_accounts,
     public.avito_report_chat_links,
     public.avito_report_logs,
     public.avito_report_metrics,
     public.avito_report_expenses,
     public.avito_report_item_cache,
     public.avito_report_stats_cache,
     public.avito_report_snapshots,
     public.avito_report_sync_jobs,
     public.avito_telegram_delivery_queue
  to service_role;

notify pgrst, 'reload schema';
